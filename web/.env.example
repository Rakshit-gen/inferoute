# Clerk — dashboard auth. Create an app at https://dashboard.clerk.com,
# then copy the keys from its API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional: pre-fills the gateway URL on the Connections form (dev convenience).
# Gateways are registered per-account in the app, not via env.
NEXT_PUBLIC_DEFAULT_GATEWAY_URL=http://localhost:8081
